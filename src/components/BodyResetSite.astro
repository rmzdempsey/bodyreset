---
import BrandLogo from './BrandLogo.astro';
import { brand, caseStudies, faqs, services, socialLinks } from '../content';

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(brand.mapQuery)}&t=&z=12&ie=UTF8&iwloc=&output=embed`;
const consultImage = '/georgia-consultation.png';
const treatmentImage = '/georgia-treatment.png';
const acupunctureImage = '/georgia-acupuncture.png';
const cuppingImage = '/georgia-cupping-prep.png';
const followupImage = consultImage;
---
<main class="site theme-georgiaclinic">
  <nav class="topbar" aria-label="Primary navigation">
    <BrandLogo />
    <div class="navlinks">
      <a href="#services">Services</a>
      <a href="/about/">About Georgia</a>
      <a href="#results">Results</a>
      <a href="#contact">Contact</a>
    </div>
    <div class="social-links nav-social" aria-label="Social media links">
      {socialLinks.filter((social) => social.label === 'Instagram' || social.label === 'Facebook').map((social) => (
        <a href={social.href} aria-label={social.label}>{social.short}</a>
      ))}
    </div>
    <a class="nav-cta" href={brand.bookingUrl}>Book online</a>
  </nav>

  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Injury & pain management</p>
      <h1>Reset pain, rebuild confidence, and move with purpose.</h1>
      <p class="lead">Sports rehabilitation, hands-on treatment, and strength and conditioning with Georgia Ashton. Personal support to help you recover from injury, build confidence, and return to the activities you love.</p>
      <div class="hero-actions">
        <a class="button primary" href={brand.bookingUrl}>Book an appointment</a>
        <a class="button secondary" href="#services">Explore services</a>
      </div>
      <dl class="hero-stats">
        <div><dt>BSc (Hons)</dt><dd>Degree-qualified care</dd></div>
        <div><dt>1:1</dt><dd>Care with Georgia</dd></div>
        <div><dt>Goal-led</dt><dd>Recovery plans</dd></div>
      </dl>
    </div>
    <div class="hero-media visual-georgiaclinic" aria-label="Care led by Georgia">
      <div class="photo-hero-stage rehab-photo-stage">
        <img src="/georgia-sports-rehabilitation.png" alt="AI-generated illustration of Georgia assisting a client with a leg rehabilitation exercise" width="1536" height="1024" />
        <div class="photo-hero-card">
          <span>Clean clinical care</span>
          <strong>Care led by Georgia</strong>
          <small>Support for injury recovery, everyday movement, and sporting performance</small>
        </div>
      </div>
    </div>
  </section>

  <section class="intro-band">
    <p>Book a Body Reset consultation, sports therapy and rehabilitation, sports or deep tissue massage, acupuncture therapy, or cupping therapy.</p>
    <div class="intro-actions">
      <a href={brand.phoneHref}>{brand.phone}</a>
      <div class="social-links">
        {socialLinks.map((social) => (
          <a href={social.href} aria-label={social.label}>{social.short}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-intro" aria-labelledby="meet-georgia">
    <div>
      <p class="kicker">Meet your practitioner</p>
      <h2 id="meet-georgia">Hi, I’m Georgia</h2>
      <p class="about-role">Sports rehabilitator &amp; strength and conditioning practitioner</p>
    </div>
    <div class="about-copy">
      <p>I know how much an injury can affect your life. After an injury brought my competitive swimming career to an end, the support of a sports rehabilitator inspired me to help others through their own recovery.</p>
      <p>With a BSc (Hons) from Plymouth University and experience in clinical and team sport settings, I work with people of different ages and activity levels—from runners and rugby players to older adults who want to move more comfortably and confidently.</p>
      <a class="button primary" href="/about/">Read my story &amp; qualifications</a>
    </div>
  </section>

  <section class="section services" id="services">
    <div class="section-heading">
      <p class="kicker">Services</p>
      <h2>Treatment that meets you where you are</h2>
      <p>Choose from the appointments below. View current availability and prices when you book online.</p>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="card service-card">
          <img class="service-photo" src={service.image.src} alt={service.image.alt} />
          <span class="service-mark"></span>
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <p class="service-price"><strong>From £{Math.min(...service.appointments.map((appointment) => Number(appointment.price.replace('£', '')))).toFixed(2)}</strong></p>
          
          <a class="button primary" href={brand.bookingUrl}>Book online</a>
        </article>
      ))}
    </div>
  </section>


  <section class="section distributed-band distributed-consult">
      <img src={consultImage} alt={'Georgia talking with a patient during an assessment'} />
      <div>
        <p class="kicker">Assessment</p>
        <h2>Start with the story behind the pain</h2>
        <p>Georgia listens to your symptoms, assesses your movement, and builds a treatment plan around your goals.</p>
      </div>
    </section>

  <section class="section process">
    <div>
      <p class="kicker">How It Works</p>
      <h2>A clear route from first chat to follow-up plan</h2>
    </div>
    <div class="steps">
      <article><span>01</span><h3>Assess</h3><p>Discuss your symptoms, goals, training, work, and movement history.</p></article>
      <article><span>02</span><h3>Treat</h3><p>Use the right blend of hands-on therapy, acupuncture, or cupping.</p></article>
      <article><span>03</span><h3>Progress</h3><p>Leave with practical steps that support recovery between sessions.</p></article>
    </div>
  </section>

  <section class="section split-treatment">
      <div>
        <p class="kicker">Treatment Options</p>
        <h2>Care tailored to your treatment needs</h2>
      </div>
      <div class="treatment-photo-grid">
        <figure>
          <img src={treatmentImage} alt={'Georgia administering hands-on treatment'} />
          <figcaption>Massage and hands-on treatment</figcaption>
        </figure>
        <figure>
          <img src={acupunctureImage} alt={'Georgia explaining acupuncture equipment in a clean clinic'} />
          <figcaption>Acupuncture therapy</figcaption>
        </figure>
        <figure>
          <img src={cuppingImage} alt={'Georgia preparing dry cupping equipment on a clean tray'} />
          <figcaption>Dry cupping preparation</figcaption>
        </figure>
      </div>
    </section>

  <section class="section results" id="results">
    <div class="section-heading">
      <p class="kicker">Case Studies</p>
      <h2>Examples of client progress</h2>
    </div>
    <div class="case-list">
      {caseStudies.map((study) => (
        <article class="case-item">
          <h3>{study.title}</h3>
          <p>{study.result}</p>
          <strong>{study.plan}</strong>
        </article>
      ))}
    </div>
  </section>

  <section class="section distributed-band distributed-progress">
      <div>
        <p class="kicker">Progress</p>
        <h2>Aftercare that feels structured and personal</h2>
        <p>Practical aftercare and a personal exercise plan help you keep making progress between appointments.</p>
      </div>
      <img src={followupImage} alt={'Georgia reviewing next steps with a patient'} />
    </section>

  <section class="section visit">
    <div class="visit-copy">
      <p class="kicker">Location</p>
      <h2>Easy to find, simple to book</h2>
      <p class="salon-note">Georgia welcomes clients at <a href="https://www.yell.com/biz/skin-deep-health-and-beauty-leyland-1106913/">Skin Deep salon in Leyland</a>.</p>
      <p>{brand.location}. Share your preferred times and the reason for your visit, and Georgia will confirm the best appointment option.</p>
      <div class="contact-strip">
        <a href={brand.phoneHref}>{brand.phone}</a>
        <span>{brand.owner}</span>
      </div>
      <div class="social-links contact-social" aria-label="Social media links">
        {socialLinks.map((social) => (
          <a href={social.href} aria-label={social.label}>{social.label}</a>
        ))}
      </div>
    </div>
    <div class="map-panel">
      <iframe title="Map for Body Reset by Georgia" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <section class="section contact-image-band">
      <img src={consultImage} alt={'Friendly consultation with Georgia in a clean physiotherapy clinic'} />
      <div>
        <p class="kicker">Ready To Book</p>
        <h2>Take the first step towards moving well again</h2>
        <a class="button primary" href={brand.bookingUrl}>Book an appointment</a>
      </div>
    </section>

  <section class="section contact" id="contact">
    <div class="contact-copy">
      <p class="kicker">Contact</p>
      <h2>Tell Georgia what you need help with</h2>
      <p>Book online to choose an appointment and time, or use the form for questions about treatment. For a faster reply, call directly.</p>
      <a class="phone-link" href={brand.phoneHref}>{brand.phone}</a>
    </div>
    <form class="contact-form" name="body-reset-contact" method="post" action={`https://formsubmit.co/${brand.email}`}>
      <input type="hidden" name="_subject" value="New Body Reset website enquiry" />
      <input type="hidden" name="_template" value="table" />
      <label>
        Name
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        Phone or email
        <input name="contact" type="text" autocomplete="email" required />
      </label>
      <label>
        Interested in
        <select name="service" required>
          <option value="">Choose a service</option>
          {services.flatMap((service) => service.appointments).map((appointment) => <option value={appointment.title}>{appointment.title}</option>)}
        </select>
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit">Send enquiry</button>
    </form>
  </section>

  <section class="section faq">
    <div class="section-heading">
      <p class="kicker">Good To Know</p>
      <h2>Before you book</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <footer class="site-footer">
    <BrandLogo />
    <div class="social-links">
      {socialLinks.map((social) => (
        <a href={social.href} aria-label={social.label}>{social.short}</a>
      ))}
    </div>
    <a href={brand.phoneHref}>{brand.phone}</a>
  </footer>
</main>
