---
import { brand, caseStudies, faqs, reviews, services, socialLinks } from '../content';

const { concept } = Astro.props;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(brand.mapQuery)}&t=&z=12&ie=UTF8&iwloc=&output=embed`;
const isCardVisual = concept.visual === 'card';
const isRunnerVisual = concept.visual === 'runner';
const isBlueGoldVisual = concept.visual === 'bluegold';
const isAnatomyPhotoVisual = concept.visual === 'anatomyphoto';
const isClinicJourneyVisual = concept.visual === 'clinicjourney';
const isDistributedClinicVisual = concept.visual === 'distributedclinic';
const isGeorgiaClinicVisual = concept.visual === 'georgiaclinic';
const isSpreadClinicVisual = isDistributedClinicVisual || isGeorgiaClinicVisual;
const serviceImages = isGeorgiaClinicVisual ? [
  { src: '/georgia-treatment.png', alt: 'Georgia administering hands-on treatment' },
  { src: '/georgia-acupuncture.png', alt: 'Georgia explaining acupuncture equipment in a clean clinic' },
  { src: '/georgia-cupping-prep.png', alt: 'Georgia preparing dry cupping equipment on a clean tray' },
  { src: '/georgia-consultation.png', alt: 'Georgia reviewing a treatment plan with a patient' }
] : [
  { src: '/clinic-treatment.png', alt: 'Physiotherapist administering hands-on treatment' },
  { src: '/clinic-acupuncture.png', alt: 'Clinician explaining acupuncture equipment in a clean clinic' },
  { src: '/clinic-cupping-equipment.png', alt: 'Dry cupping equipment prepared on a clean medical tray' },
  { src: '/clinic-followup.png', alt: 'Clinic professional reviewing an exercise plan with a patient' }
];
const consultImage = isGeorgiaClinicVisual ? '/georgia-consultation.png' : '/clinic-consultation.png';
const treatmentImage = isGeorgiaClinicVisual ? '/georgia-treatment.png' : '/clinic-treatment.png';
const acupunctureImage = isGeorgiaClinicVisual ? '/georgia-acupuncture.png' : '/clinic-acupuncture.png';
const cuppingImage = isGeorgiaClinicVisual ? '/georgia-cupping-prep.png' : '/clinic-cupping-equipment.png';
const followupImage = isGeorgiaClinicVisual ? '/georgia-consultation.png' : '/clinic-followup.png';
---
<main class={`site ${concept.className}`}>
  <nav class="topbar" aria-label="Primary navigation">
    <a class="wordmark" href="/">
      <span>{brand.name}</span>
      <small>{brand.byline}</small>
    </a>
    <div class="navlinks">
      <a href="#services">Services</a>
      <a href="#results">Results</a>
      <a href="#reviews">Reviews</a>
      <a href="#contact">Contact</a>
    </div>
    <div class="social-links nav-social" aria-label="Social media links">
      {socialLinks.slice(0, 3).map((social) => (
        <a href={social.href} aria-label={social.label}>{social.short}</a>
      ))}
    </div>
    <a class="nav-cta" href={brand.phoneHref}>Call</a>
  </nav>

  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Injury & pain management</p>
      <h1>Reset pain, rebuild confidence, and move with purpose.</h1>
      <p class="lead">{brand.tagline}</p>
      <div class="hero-actions">
        <a class="button primary" href="#contact">Book an appointment</a>
        <a class="button secondary" href="#services">Explore services</a>
      </div>
      <dl class="hero-stats">
        <div><dt>4</dt><dd>Treatment options</dd></div>
        <div><dt>1:1</dt><dd>Care with Georgia</dd></div>
        <div><dt>Goal-led</dt><dd>Recovery plans</dd></div>
      </dl>
    </div>
    <div class={`hero-media visual-${concept.visual}`} aria-label={`${concept.name} visual concept`}>
      {isCardVisual ? (
        <img src="/businesscard.jpeg" alt="Body Reset by Georgia business card" />
      ) : isRunnerVisual ? (
        <div class="runner-stage" role="img" aria-label="Dynamic runner in motion">
          <div class="sun"></div>
          <div class="track-lines"></div>
          <svg class="runner-figure" viewBox="0 0 520 420" aria-hidden="true">
            <path class="runner-shadow" d="M112 336c70-16 186-16 276 0" />
            <circle class="runner-head" cx="292" cy="90" r="30" />
            <path class="runner-body" d="M266 124c-28 35-42 70-41 107M264 132c35 25 68 34 105 25M228 229c-42 12-76 33-103 72M226 228c43 23 70 58 83 105M243 166c-34 2-68-8-102-32M368 158c28 17 52 37 71 62" />
            <path class="runner-glow" d="M86 151c72-42 151-57 235-45 45 6 82 20 112 42M79 226c77-35 158-42 243-20 48 12 88 33 120 61" />
          </svg>
          <div class="runner-card">
            <span>Running recovery</span>
            <strong>Stride, calf, hip, load</strong>
            <small>Sports massage + strength plan</small>
          </div>
        </div>
      ) : isBlueGoldVisual ? (
        <div class="photo-hero-stage">
          <img src="/runner-blue-gold.png" alt="Runner in motion on a sunrise track" />
          <div class="photo-hero-card">
            <span>Run stronger</span>
            <strong>Sports massage for runners</strong>
            <small>Calf, hamstring, hip and load-management support</small>
          </div>
        </div>
      ) : isAnatomyPhotoVisual || isClinicJourneyVisual || isSpreadClinicVisual ? (
        <div class="photo-hero-stage anatomy-photo-stage">
          <img src="/dynamic-running-anatomy-stockcake.jpg" alt="Dynamic running anatomy illustration" />
          <div class="photo-hero-card">
            <span>{isClinicJourneyVisual || isSpreadClinicVisual ? 'Clean clinical care' : 'Sport science'}</span>
            <strong>{isGeorgiaClinicVisual ? 'Care led by Georgia' : isDistributedClinicVisual ? 'A complete treatment experience' : isClinicJourneyVisual ? 'Assessment, treatment, follow-up' : 'Where movement meets treatment'}</strong>
            <small>{isGeorgiaClinicVisual ? 'A personal, practitioner-led experience across every treatment touchpoint' : isDistributedClinicVisual ? 'Massage, acupuncture, cupping, and training support shown across the whole page' : isClinicJourneyVisual ? 'A reassuring clinic journey from first chat to progress plan' : 'Running mechanics, soft tissue care, and progressive strength planning'}</small>
          </div>
        </div>
      ) : (
        <div class="visual-stage">
          <svg class="anatomy-figure" viewBox="0 0 240 420" role="img" aria-label="Stylised body anatomy diagram">
            <path class="body-line" d="M120 35c23 0 42 19 42 42s-19 42-42 42-42-19-42-42 19-42 42-42Z" />
            <path class="body-line" d="M120 125v112M76 156c30 18 58 18 88 0M82 215l-24 94M158 215l24 94M103 237l-14 132M137 237l14 132" />
            <path class="muscle" d="M88 145c-18 34-17 67 0 103M152 145c18 34 17 67 0 103M103 137c12 22 22 45 17 91M137 137c-12 22-22 45-17 91" />
            <circle class="pulse one" cx="88" cy="183" r="10" />
            <circle class="pulse two" cx="152" cy="217" r="10" />
            <circle class="pulse three" cx="91" cy="324" r="10" />
          </svg>
          <div class="photo-stack" aria-hidden="true">
            <span class="photo photo-treatment"></span>
            <span class="photo photo-gym"></span>
            <span class="photo photo-cupping"></span>
          </div>
          <div class="scan-card">
            <span>Assessment</span>
            <strong>Neck / shoulder / calf</strong>
            <small>Massage + mobility + load plan</small>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="intro-band">
    <p>Massage, acupuncture, dry cupping, and personal training plans are combined around your symptoms, lifestyle, and goals.</p>
    <div class="intro-actions">
      <a href={brand.phoneHref}>{brand.phone}</a>
      <div class="social-links">
        {socialLinks.map((social) => (
          <a href={social.href} aria-label={social.label}>{social.short}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section services" id="services">
    <div class="section-heading">
      <p class="kicker">Services</p>
      <h2>Treatment that meets you where you are</h2>
    </div>
    <div class="service-grid">
      {services.map((service, index) => (
        <article class="card service-card">
          {isSpreadClinicVisual && (
            <img class="service-photo" src={serviceImages[index].src} alt={serviceImages[index].alt} />
          )}
          <span class="service-mark"></span>
          <h3>{service.title}</h3>
          <p>{service.summary}</p>
          <ul>
            {service.details.map((detail) => <li>{detail}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {isClinicJourneyVisual && (
    <section class="section clinic-gallery">
      <div class="section-heading">
        <p class="kicker">Clinic Journey</p>
        <h2>Professional care shown throughout the experience</h2>
      </div>
      <div class="clinic-gallery-grid">
        <article class="clinic-photo-feature">
          <img src="/clinic-consultation.png" alt="Physiotherapist talking with a patient during an assessment" />
          <div>
            <span>Consultation</span>
            <h3>Start with a clear conversation</h3>
            <p>Georgia listens, screens movement, and builds the treatment around what you want to get back to.</p>
          </div>
        </article>
        <article class="clinic-photo-card">
          <img src="/clinic-treatment.png" alt="Physiotherapist administering hands-on treatment" />
          <div>
            <span>Treatment</span>
            <h3>Hands-on support</h3>
            <p>Calm, focused treatment in a clean clinical setting.</p>
          </div>
        </article>
        <article class="clinic-photo-card">
          <img src="/clinic-followup.png" alt="Clinic professional reviewing next steps with a patient" />
          <div>
            <span>Follow-up</span>
            <h3>Leave with next steps</h3>
            <p>Simple aftercare and training guidance to keep progress moving.</p>
          </div>
        </article>
      </div>
    </section>
  )}

  {isSpreadClinicVisual && (
    <section class="section distributed-band distributed-consult">
      <img src={consultImage} alt={isGeorgiaClinicVisual ? 'Georgia talking with a patient during an assessment' : 'Physiotherapist talking with a patient during an assessment'} />
      <div>
        <p class="kicker">Assessment</p>
        <h2>Start with the story behind the pain</h2>
        <p>More of the page carries the clinic environment, so stakeholders see a real client journey: conversation, testing, treatment, aftercare, and follow-up.</p>
      </div>
    </section>
  )}

  <section class="section image-story">
    <div class="section-heading">
      <p class="kicker">Treatment Focus</p>
      <h2>Visual, practical, and tailored to the way you move</h2>
    </div>
    <div class="story-grid">
      <article class="story-panel anatomy-panel">
        <span class="story-art body-lines"></span>
        <h3>Find the source</h3>
        <p>Assessment-led treatment looks beyond the sore spot to understand load, posture, and movement patterns.</p>
      </article>
      <article class="story-panel sports-panel">
        <span class="story-art sports-photo"></span>
        <h3>Treat with intent</h3>
        <p>Massage, acupuncture, and cupping can be combined when that best suits the session goal.</p>
      </article>
      <article class="story-panel movement-panel">
        <span class="story-art movement-lines"></span>
        <h3>Keep progress going</h3>
        <p>Training plans and aftercare give you simple next steps between appointments.</p>
      </article>
    </div>
  </section>

  <section class="section process">
    <div>
      <p class="kicker">How It Works</p>
      <h2>A clear route from first chat to follow-up plan</h2>
    </div>
    <div class="steps">
      <article><span>01</span><h3>Assess</h3><p>Discuss your symptoms, goals, training, work, and movement history.</p></article>
      <article><span>02</span><h3>Treat</h3><p>Use the right blend of hands-on therapy, acupuncture, or cupping.</p></article>
      <article><span>03</span><h3>Progress</h3><p>Leave with practical steps that support recovery between sessions.</p></article>
    </div>
  </section>

  {isSpreadClinicVisual && (
    <section class="section split-treatment">
      <div>
        <p class="kicker">Treatment Options</p>
        <h2>Hands-on care, acupuncture, and cupping are visible where they are discussed</h2>
      </div>
      <div class="treatment-photo-grid">
        <figure>
          <img src={treatmentImage} alt={isGeorgiaClinicVisual ? 'Georgia administering hands-on treatment' : 'Physiotherapist administering hands-on treatment'} />
          <figcaption>Massage and hands-on treatment</figcaption>
        </figure>
        <figure>
          <img src={acupunctureImage} alt={isGeorgiaClinicVisual ? 'Georgia explaining acupuncture equipment in a clean clinic' : 'Clinician explaining acupuncture equipment in a clean clinic'} />
          <figcaption>Acupuncture consultation</figcaption>
        </figure>
        <figure>
          <img src={cuppingImage} alt={isGeorgiaClinicVisual ? 'Georgia preparing dry cupping equipment on a clean tray' : 'Dry cupping equipment prepared on a clean medical tray'} />
          <figcaption>Dry cupping preparation</figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section results" id="results">
    <div class="section-heading">
      <p class="kicker">Case Studies</p>
      <h2>Examples of client progress</h2>
    </div>
    <div class="case-list">
      {caseStudies.map((study) => (
        <article class="case-item">
          <h3>{study.title}</h3>
          <p>{study.result}</p>
          <strong>{study.plan}</strong>
        </article>
      ))}
    </div>
  </section>

  {isSpreadClinicVisual && (
    <section class="section distributed-band distributed-progress">
      <div>
        <p class="kicker">Progress</p>
        <h2>Aftercare that feels structured and personal</h2>
        <p>Follow-up imagery breaks up the lower page and reinforces that Body Reset is more than a one-off treatment appointment.</p>
      </div>
      <img src={followupImage} alt={isGeorgiaClinicVisual ? 'Georgia reviewing next steps with a patient' : 'Clinic professional reviewing next steps with a patient'} />
    </section>
  )}

  <section class="section reviews" id="reviews">
    <div class="section-heading">
      <p class="kicker">Reviews</p>
      <h2>What clients say</h2>
    </div>
    <div class="review-grid">
      {reviews.map((review) => (
        <figure class="card review-card">
          <blockquote>{review.quote}</blockquote>
          <figcaption>{review.name}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section visit">
    <div class="visit-copy">
      <p class="kicker">Location</p>
      <h2>Easy to find, simple to book</h2>
      <p>{brand.location}. Share your preferred times and the reason for your visit, and Georgia will confirm the best appointment option.</p>
      <div class="contact-strip">
        <a href={brand.phoneHref}>{brand.phone}</a>
        <span>{brand.owner}</span>
      </div>
      <div class="social-links contact-social" aria-label="Social media links">
        {socialLinks.map((social) => (
          <a href={social.href} aria-label={social.label}>{social.label}</a>
        ))}
      </div>
    </div>
    <div class="map-panel">
      <iframe title="Map for Body Reset by Georgia" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  {isSpreadClinicVisual && (
    <section class="section contact-image-band">
      <img src={consultImage} alt={isGeorgiaClinicVisual ? 'Friendly consultation with Georgia in a clean physiotherapy clinic' : 'Friendly consultation in a clean physiotherapy clinic'} />
      <div>
        <p class="kicker">Ready To Book</p>
        <h2>A clean, professional clinic feel right through to enquiry</h2>
      </div>
    </section>
  )}

  <section class="section contact" id="contact">
    <div class="contact-copy">
      <p class="kicker">Contact</p>
      <h2>Tell Georgia what you need help with</h2>
      <p>Use the form for appointment requests, injury questions, or training-plan enquiries. For a faster reply, call directly.</p>
      <a class="phone-link" href={brand.phoneHref}>{brand.phone}</a>
    </div>
    <form class="contact-form" name="body-reset-contact" method="post" data-netlify="true">
      <input type="hidden" name="form-name" value="body-reset-contact" />
      <label>
        Name
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        Phone or email
        <input name="contact" type="text" autocomplete="email" required />
      </label>
      <label>
        Interested in
        <select name="service" required>
          <option value="">Choose a service</option>
          {services.map((service) => <option value={service.title}>{service.title}</option>)}
        </select>
      </label>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit">Send enquiry</button>
    </form>
  </section>

  <section class="section faq">
    <div class="section-heading">
      <p class="kicker">Good To Know</p>
      <h2>Before you book</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <footer class="site-footer">
    <a class="wordmark" href="/">
      <span>{brand.name}</span>
      <small>{brand.byline}</small>
    </a>
    <div class="social-links">
      {socialLinks.map((social) => (
        <a href={social.href} aria-label={social.label}>{social.short}</a>
      ))}
    </div>
    <a href={brand.phoneHref}>{brand.phone}</a>
  </footer>
</main>
