---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptSite from '../../components/ConceptSite.astro';
import { concepts } from '../../content';

export function getStaticPaths() {
  return concepts.map((concept) => ({
    params: { slug: concept.slug },
    props: { concept }
  }));
}

const { concept } = Astro.props;
---
<BaseLayout title={`${concept.name} | Body Reset by Georgia`}>
  <ConceptSite concept={concept} />
</BaseLayout>
<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: var(--paper); }
  a { color: inherit; }
  .site {
    --paper: #f7f2ea;
    --ink: #332f28;
    --muted: #756f64;
    --panel: rgba(255, 255, 255, .74);
    --line: rgba(51, 47, 40, .12);
    --accent: #9b845d;
    --accent-2: #849182;
    --dark: #2f2b25;
    --button: #3f3a32;
    min-height: 100vh;
    overflow: hidden;
  }
  .theme-calm { --paper: #f7f2ea; --ink: #3e3931; --muted: #736c60; --accent: #a7895d; --accent-2: #9aa594; --panel: rgba(255,255,255,.78); }
  .theme-performance { --paper: #f8f5ef; --ink: #231f1c; --muted: #6b625a; --accent: #dc6b35; --accent-2: #2d6965; --panel: rgba(255,255,255,.86); --button: #1f1e1b; }
  .theme-editorial { --paper: #fbfaf7; --ink: #28241e; --muted: #6f675b; --accent: #7f6849; --accent-2: #b9c7c4; --panel: #ffffff; --button: #7f6849; }
  .theme-natural { --paper: #f2efe6; --ink: #303327; --muted: #646c56; --accent: #6f7f55; --accent-2: #b08e6c; --panel: rgba(255,255,250,.8); --button: #52623e; }
  .theme-medical { --paper: #f7fbfb; --ink: #1e3034; --muted: #5d7074; --accent: #277d8c; --accent-2: #b18e5c; --panel: rgba(255,255,255,.9); --button: #215f6d; }
  .theme-anatomy { --paper: #f4f7f4; --ink: #142827; --muted: #58706d; --accent: #d45d48; --accent-2: #48a3a0; --panel: rgba(255,255,255,.82); --button: #143331; --dark: #142827; }
  .theme-sports { --paper: #f6f7ef; --ink: #161b18; --muted: #596258; --accent: #ef7746; --accent-2: #397e70; --panel: rgba(255,255,255,.86); --button: #18221e; --dark: #18221e; }
  .theme-kinetic { --paper: #f7f8ff; --ink: #18203b; --muted: #58617e; --accent: #5569ff; --accent-2: #00a78e; --panel: rgba(255,255,255,.8); --button: #18203b; --dark: #161b32; }
  .theme-elite { --paper: #10100f; --ink: #f4efe6; --muted: #b9aa95; --accent: #c98b4f; --accent-2: #68716d; --panel: rgba(32,31,29,.84); --line: rgba(244,239,230,.14); --button: #c98b4f; --dark: #050505; }
  .theme-bodymap { --paper: #f8f1f3; --ink: #2f2930; --muted: #756875; --accent: #9a6fb1; --accent-2: #77a99a; --panel: rgba(255,255,255,.82); --button: #513d5f; --dark: #302834; }
  .theme-runner { --paper: #e8f7f6; --ink: #12282e; --muted: #526b70; --accent: #ff6b54; --accent-2: #16a6a2; --panel: rgba(255,255,255,.84); --button: #12343a; --dark: #10292e; }
  .theme-bluegold { --paper: #071a33; --ink: #fff8e6; --muted: #c5d1df; --accent: #d9a441; --accent-2: #2f7bbb; --panel: rgba(8, 26, 51, .78); --line: rgba(255, 248, 230, .16); --button: #d9a441; --dark: #031020; }
  .theme-skygold { --paper: #eef8ff; --ink: #16304d; --muted: #5b7185; --accent: #d6a23c; --accent-2: #5aa7d8; --panel: rgba(255,255,255,.86); --line: rgba(22,48,77,.13); --button: #1e5f92; --dark: #16304d; }
  .theme-mint { --paper: #effbf6; --ink: #17352f; --muted: #5d746d; --accent: #1fae9b; --accent-2: #8fd7c6; --panel: rgba(255,255,255,.84); --line: rgba(23,53,47,.12); --button: #17695f; --dark: #17352f; }
  .theme-sunrise { --paper: #fff3eb; --ink: #3d2f35; --muted: #7d6d6f; --accent: #df9272; --accent-2: #f0c66d; --panel: rgba(255,255,255,.82); --line: rgba(61,47,53,.12); --button: #8b5d73; --dark: #3d2f35; }
  .theme-anatomyphoto { --paper: #081828; --ink: #f3fbff; --muted: #b8c9d5; --accent: #48d6ff; --accent-2: #f0b84c; --panel: rgba(8, 24, 40, .78); --line: rgba(243,251,255,.15); --button: #48d6ff; --dark: #020912; }
  .theme-cleananatomy { --paper: #f5fcff; --ink: #173244; --muted: #667c89; --accent: #31b6c7; --accent-2: #a7dff0; --panel: rgba(255,255,255,.88); --line: rgba(23,50,68,.12); --button: #247f91; --dark: #173244; }
  .theme-pureclinic { --paper: #ffffff; --ink: #1e3546; --muted: #637887; --accent: #347fbd; --accent-2: #d9edf8; --panel: rgba(255,255,255,.92); --line: rgba(30,53,70,.12); --button: #286999; --dark: #1e3546; }
  .theme-aqualab { --paper: #eefdfb; --ink: #143936; --muted: #5d7774; --accent: #22b8b2; --accent-2: #bceee9; --panel: rgba(255,255,255,.86); --line: rgba(20,57,54,.12); --button: #14817d; --dark: #143936; }
  .theme-softhealth { --paper: #fffafa; --ink: #334050; --muted: #707d8d; --accent: #7ab6d8; --accent-2: #f4c8c0; --panel: rgba(255,255,255,.88); --line: rgba(51,64,80,.11); --button: #5c8fb0; --dark: #334050; }
  .theme-clinicjourney { --paper: #f6fdff; --ink: #1c3a45; --muted: #617b86; --accent: #29aeb8; --accent-2: #cceef5; --panel: rgba(255,255,255,.9); --line: rgba(28,58,69,.12); --button: #247f91; --dark: #1c3a45; }
  .theme-distributedclinic { --paper: #f7fdff; --ink: #1c3942; --muted: #627b83; --accent: #38aeb7; --accent-2: #d7f1f4; --panel: rgba(255,255,255,.9); --line: rgba(28,57,66,.12); --button: #247f91; --dark: #1c3942; }
  .theme-georgiaclinic { --paper: #f8fcfb; --ink: #343c38; --muted: #6d7b76; --accent: #8b7655; --accent-2: #d5ece8; --panel: rgba(255,255,255,.9); --line: rgba(52,60,56,.12); --button: #687f79; --dark: #343c38; }
  .site::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--accent-2) 20%, transparent), transparent 38%),
      radial-gradient(circle at 85% 12%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 30%),
      var(--paper);
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    min-height: 72px;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 24px;
    align-items: center;
    padding: 16px clamp(18px, 4vw, 48px);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(18px);
  }
  .wordmark { text-decoration: none; display: flex; align-items: baseline; gap: 8px; font-family: Georgia, serif; font-size: 1.45rem; }
  .wordmark small { font-family: inherit; font-size: .82rem; color: var(--muted); }
  .navlinks { justify-self: center; display: flex; gap: clamp(14px, 3vw, 34px); font-size: .95rem; color: var(--muted); }
  .navlinks a, .nav-cta, .button { text-decoration: none; }
  .navlinks a:hover { color: var(--ink); }
  .social-links { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .social-links a {
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    color: var(--ink);
    text-decoration: none;
    font-size: .78rem;
    font-weight: 900;
    transition: transform .2s ease, background .2s ease;
  }
  .social-links a:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--accent) 14%, var(--panel)); }
  .nav-cta, .button, .contact-form button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 0 18px;
    border: 1px solid var(--line);
    font-weight: 800;
    cursor: pointer;
  }
  .nav-cta, .primary, .contact-form button { color: white; background: var(--button); border-color: var(--button); }
  .secondary { background: var(--panel); }
  .hero {
    min-height: calc(100vh - 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, .7fr);
    gap: clamp(34px, 6vw, 88px);
    align-items: center;
    padding: clamp(36px, 6vw, 86px) clamp(18px, 5vw, 72px) clamp(80px, 10vw, 130px);
  }
  .hero-copy { max-width: 760px; animation: rise .7s ease both; }
  .kicker {
    margin: 0 0 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .76rem;
    font-weight: 900;
  }
  h1, h2, h3, p { overflow-wrap: anywhere; }
  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 8vw, 7.6rem);
    line-height: .91;
    letter-spacing: 0;
  }
  h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2rem, 4vw, 4.2rem); line-height: 1; letter-spacing: 0; }
  h3 { margin: 0; font-size: 1.08rem; letter-spacing: 0; }
  .lead { margin: 24px 0 0; color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; max-width: 650px; }
  .hero-actions { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-stats {
    margin: 42px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .hero-stats div, .card, .case-item, .steps article, details, .contact-form, .map-panel {
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 8px;
    box-shadow: 0 18px 48px rgba(22, 20, 18, .06);
  }
  .hero-stats div { padding: 16px; }
  .hero-stats dt { font-weight: 900; font-size: 1.5rem; color: var(--accent); }
  .hero-stats dd { margin: 4px 0 0; color: var(--muted); }
  .hero-media {
    min-height: 520px;
    display: grid;
    place-items: center;
    animation: floatIn .9s ease both;
  }
  .hero-media img {
    width: min(100%, 390px);
    aspect-ratio: 9 / 13;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 30px 90px rgba(33, 30, 26, .22);
    transform: rotate(1.5deg);
  }
  .visual-stage {
    width: min(100%, 520px);
    min-height: 560px;
    position: relative;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-2) 20%, transparent), transparent 42%),
      linear-gradient(315deg, color-mix(in srgb, var(--accent) 18%, transparent), transparent 48%),
      color-mix(in srgb, var(--panel) 88%, var(--paper));
    box-shadow: 0 30px 90px rgba(18, 17, 15, .16);
  }
  .visual-stage::before {
    content: "";
    position: absolute;
    inset: 22px;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 8px;
    background-image:
      linear-gradient(color-mix(in srgb, var(--ink) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 8%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: .55;
  }
  .anatomy-figure {
    width: min(68%, 310px);
    max-height: 470px;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 18px 32px rgba(0,0,0,.12));
  }
  .body-line, .muscle { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .body-line { stroke: color-mix(in srgb, var(--ink) 62%, transparent); stroke-width: 6; }
  .muscle { stroke: var(--accent); stroke-width: 4; opacity: .72; }
  .pulse { fill: color-mix(in srgb, var(--accent) 75%, white); opacity: .82; transform-origin: center; animation: pulse 2.4s ease-in-out infinite; }
  .pulse.two { animation-delay: .45s; }
  .pulse.three { animation-delay: .9s; }
  .photo-stack {
    position: absolute;
    inset: auto 24px 24px 24px;
    z-index: 3;
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 10px;
  }
  .photo {
    min-height: 110px;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, white 24%, var(--line));
    background-size: cover;
    background-position: center;
    box-shadow: 0 18px 38px rgba(0,0,0,.18);
  }
  .photo-treatment {
    grid-row: span 2;
    background:
      radial-gradient(ellipse at 50% 35%, rgba(255,255,255,.72) 0 10%, transparent 11%),
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 64%, #2b2b2b), color-mix(in srgb, var(--accent-2) 55%, #111));
  }
  .photo-gym {
    background:
      linear-gradient(25deg, transparent 0 42%, rgba(255,255,255,.55) 43% 49%, transparent 50%),
      linear-gradient(145deg, color-mix(in srgb, var(--accent-2) 72%, #202020), #171817);
  }
  .photo-cupping {
    background:
      radial-gradient(circle at 35% 45%, rgba(255,255,255,.68) 0 13%, transparent 14%),
      radial-gradient(circle at 66% 52%, rgba(255,255,255,.45) 0 12%, transparent 13%),
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 58%, #222), #26201d);
  }
  .scan-card {
    position: absolute;
    top: 28px;
    left: 28px;
    right: 28px;
    z-index: 4;
    display: grid;
    gap: 4px;
    padding: 16px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    border: 1px solid var(--line);
    backdrop-filter: blur(14px);
  }
  .scan-card span, .scan-card small { color: var(--muted); }
  .scan-card strong { color: var(--ink); }
  .runner-stage {
    width: min(100%, 560px);
    min-height: 560px;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background:
      linear-gradient(180deg, rgba(255,255,255,.66), transparent 46%),
      radial-gradient(circle at 25% 18%, rgba(255,255,255,.9), transparent 16%),
      linear-gradient(135deg, #bfe9ef 0%, #e8f7f6 42%, #ffb59a 100%);
    box-shadow: 0 30px 90px rgba(18, 40, 46, .2);
  }
  .sun {
    position: absolute;
    top: 42px;
    left: 42px;
    width: 92px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff4b8;
    box-shadow: 0 0 80px rgba(255, 190, 84, .42);
  }
  .track-lines {
    position: absolute;
    inset: auto -10% 0 -10%;
    height: 42%;
    background:
      repeating-linear-gradient(174deg, rgba(18,40,46,.18) 0 2px, transparent 2px 34px),
      linear-gradient(180deg, transparent, rgba(255,107,84,.3));
    transform: skewY(-5deg);
    animation: runnerTrack 5s linear infinite;
  }
  .runner-figure {
    width: min(88%, 480px);
    position: relative;
    z-index: 2;
    overflow: visible;
    animation: runnerFloat 3s ease-in-out infinite;
  }
  .runner-shadow, .runner-body, .runner-glow {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .runner-shadow { stroke: rgba(18,40,46,.2); stroke-width: 18; }
  .runner-head { fill: #12343a; }
  .runner-body { stroke: #12343a; stroke-width: 24; }
  .runner-glow { stroke: #ff6b54; stroke-width: 8; opacity: .72; stroke-dasharray: 22 24; animation: dashFlow 2.6s linear infinite; }
  .runner-card {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    z-index: 3;
    display: grid;
    gap: 4px;
    padding: 16px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,.52);
    background: rgba(255,255,255,.72);
    backdrop-filter: blur(16px);
  }
  .runner-card span, .runner-card small { color: var(--muted); }
  .runner-card strong { color: var(--ink); }
  .photo-hero-stage {
    width: min(100%, 660px);
    min-height: 560px;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: #061b39;
    box-shadow: 0 32px 100px rgba(0,0,0,.34);
  }
  .photo-hero-stage img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    display: block;
    object-fit: cover;
    object-position: 58% center;
    transform: scale(1.02);
    animation: photoDrift 9s ease-in-out infinite alternate;
  }
  .photo-hero-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(3,16,32,.48), transparent 42%),
      linear-gradient(0deg, rgba(3,16,32,.56), transparent 45%);
  }
  .photo-hero-card {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    z-index: 2;
    display: grid;
    gap: 5px;
    padding: 18px;
    border-radius: 8px;
    border: 1px solid rgba(255,248,230,.22);
    background: rgba(3,16,32,.62);
    color: #fff8e6;
    backdrop-filter: blur(16px);
  }
  .photo-hero-card span {
    color: #d9a441;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .75rem;
    font-weight: 900;
  }
  .photo-hero-card strong { font-size: clamp(1.2rem, 3vw, 1.9rem); }
  .photo-hero-card small { color: #c5d1df; line-height: 1.45; }
  .anatomy-photo-stage {
    background: #081828;
    box-shadow: 0 34px 100px rgba(0, 0, 0, .36);
  }
  .anatomy-photo-stage img {
    object-position: center center;
  }
  .anatomy-photo-stage::before {
    background:
      linear-gradient(90deg, rgba(2,9,18,.66), transparent 44%),
      linear-gradient(0deg, rgba(2,9,18,.6), transparent 52%),
      radial-gradient(circle at 78% 22%, rgba(72,214,255,.2), transparent 28%);
  }
  .intro-band {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin: -60px clamp(18px, 5vw, 72px) 0;
    padding: 22px clamp(18px, 4vw, 38px);
    color: white;
    background: var(--dark);
    border-radius: 8px;
    position: relative;
    z-index: 2;
  }
  .intro-band p { margin: 0; max-width: 760px; line-height: 1.5; }
  .intro-band a { font-size: clamp(1.2rem, 3vw, 2rem); font-weight: 900; text-decoration: none; white-space: nowrap; }
  .intro-actions { display: grid; justify-items: end; gap: 10px; }
  .intro-actions .social-links a { color: white; border-color: rgba(255,255,255,.24); background: rgba(255,255,255,.08); }
  .section { padding: clamp(72px, 10vw, 132px) clamp(18px, 5vw, 72px); }
  .section-heading { max-width: 760px; margin-bottom: 34px; }
  .service-grid, .review-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .card { padding: 24px; transition: transform .25s ease, border-color .25s ease; }
  .card:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .service-mark { display: block; width: 46px; height: 6px; border-radius: 99px; background: var(--accent); margin-bottom: 26px; }
  .service-card p, .case-item p, .steps p, .review-card blockquote, .visit-copy p, .contact-copy p, details p {
    color: var(--muted);
    line-height: 1.62;
  }
  .service-card ul { padding-left: 18px; margin: 18px 0 0; color: var(--muted); line-height: 1.7; }
  .service-photo {
    width: calc(100% + 48px);
    height: 180px;
    display: block;
    object-fit: cover;
    margin: -24px -24px 22px;
    border-radius: 8px 8px 0 0;
    border-bottom: 1px solid var(--line);
  }
  .image-story { position: relative; }
  .story-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr 1fr;
    gap: 16px;
  }
  .story-panel {
    min-height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    position: relative;
    overflow: hidden;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 18px 48px rgba(22, 20, 18, .06);
  }
  .story-panel p { color: var(--muted); line-height: 1.62; margin-bottom: 0; }
  .story-art { position: absolute; inset: 0; opacity: .9; }
  .body-lines {
    background:
      radial-gradient(ellipse at 50% 16%, transparent 0 9%, var(--accent) 10% 11%, transparent 12%),
      radial-gradient(ellipse at 50% 45%, transparent 0 25%, color-mix(in srgb, var(--accent-2) 60%, transparent) 26% 27%, transparent 28%),
