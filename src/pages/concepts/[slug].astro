---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptSite from '../../components/ConceptSite.astro';
import { concepts } from '../../content';

export function getStaticPaths() {
  return concepts.map((concept) => ({
    params: { slug: concept.slug },
    props: { concept }
  }));
}

const { concept } = Astro.props;
---
<BaseLayout title={`${concept.name} | Body Reset by Georgia`}>
  <ConceptSite concept={concept} />
</BaseLayout>
<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: var(--paper); }
  a { color: inherit; }
  .site {
    --paper: #f7f2ea;
    --ink: #332f28;
    --muted: #756f64;
    --panel: rgba(255, 255, 255, .74);
    --line: rgba(51, 47, 40, .12);
    --accent: #9b845d;
    --accent-2: #849182;
    --dark: #2f2b25;
    --button: #3f3a32;
    min-height: 100vh;
    overflow: hidden;
  }
  .theme-calm { --paper: #f7f2ea; --ink: #3e3931; --muted: #736c60; --accent: #a7895d; --accent-2: #9aa594; --panel: rgba(255,255,255,.78); }
  .theme-performance { --paper: #f8f5ef; --ink: #231f1c; --muted: #6b625a; --accent: #dc6b35; --accent-2: #2d6965; --panel: rgba(255,255,255,.86); --button: #1f1e1b; }
  .theme-editorial { --paper: #fbfaf7; --ink: #28241e; --muted: #6f675b; --accent: #7f6849; --accent-2: #b9c7c4; --panel: #ffffff; --button: #7f6849; }
  .theme-natural { --paper: #f2efe6; --ink: #303327; --muted: #646c56; --accent: #6f7f55; --accent-2: #b08e6c; --panel: rgba(255,255,250,.8); --button: #52623e; }
  .theme-medical { --paper: #f7fbfb; --ink: #1e3034; --muted: #5d7074; --accent: #277d8c; --accent-2: #b18e5c; --panel: rgba(255,255,255,.9); --button: #215f6d; }
  .site::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--accent-2) 20%, transparent), transparent 38%),
      radial-gradient(circle at 85% 12%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 30%),
      var(--paper);
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    min-height: 72px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 16px clamp(18px, 4vw, 48px);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(18px);
  }
  .wordmark { text-decoration: none; display: flex; align-items: baseline; gap: 8px; font-family: Georgia, serif; font-size: 1.45rem; }
  .wordmark small { font-family: inherit; font-size: .82rem; color: var(--muted); }
  .navlinks { justify-self: center; display: flex; gap: clamp(14px, 3vw, 34px); font-size: .95rem; color: var(--muted); }
  .navlinks a, .nav-cta, .button { text-decoration: none; }
  .navlinks a:hover { color: var(--ink); }
  .nav-cta, .button, .contact-form button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 0 18px;
    border: 1px solid var(--line);
    font-weight: 800;
    cursor: pointer;
  }
  .nav-cta, .primary, .contact-form button { color: white; background: var(--button); border-color: var(--button); }
  .secondary { background: var(--panel); }
  .hero {
    min-height: calc(100vh - 72px);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, .7fr);
    gap: clamp(34px, 6vw, 88px);
    align-items: center;
    padding: clamp(36px, 6vw, 86px) clamp(18px, 5vw, 72px) clamp(80px, 10vw, 130px);
  }
  .hero-copy { max-width: 760px; animation: rise .7s ease both; }
  .kicker {
    margin: 0 0 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .76rem;
    font-weight: 900;
  }
  h1, h2, h3, p { overflow-wrap: anywhere; }
  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 8vw, 7.6rem);
    line-height: .91;
    letter-spacing: 0;
  }
  h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2rem, 4vw, 4.2rem); line-height: 1; letter-spacing: 0; }
  h3 { margin: 0; font-size: 1.08rem; letter-spacing: 0; }
  .lead { margin: 24px 0 0; color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; max-width: 650px; }
  .hero-actions { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-stats {
    margin: 42px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .hero-stats div, .card, .case-item, .steps article, details, .contact-form, .map-panel {
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 8px;
    box-shadow: 0 18px 48px rgba(22, 20, 18, .06);
  }
  .hero-stats div { padding: 16px; }
  .hero-stats dt { font-weight: 900; font-size: 1.5rem; color: var(--accent); }
  .hero-stats dd { margin: 4px 0 0; color: var(--muted); }
  .hero-media {
    min-height: 520px;
    display: grid;
    place-items: center;
    animation: floatIn .9s ease both;
  }
  .hero-media img {
    width: min(100%, 390px);
    aspect-ratio: 9 / 13;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 30px 90px rgba(33, 30, 26, .22);
    transform: rotate(1.5deg);
  }
  .intro-band {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin: -60px clamp(18px, 5vw, 72px) 0;
    padding: 22px clamp(18px, 4vw, 38px);
    color: white;
    background: var(--dark);
    border-radius: 8px;
    position: relative;
    z-index: 2;
  }
  .intro-band p { margin: 0; max-width: 760px; line-height: 1.5; }
  .intro-band a { font-size: clamp(1.2rem, 3vw, 2rem); font-weight: 900; text-decoration: none; white-space: nowrap; }
  .section { padding: clamp(72px, 10vw, 132px) clamp(18px, 5vw, 72px); }
  .section-heading { max-width: 760px; margin-bottom: 34px; }
  .service-grid, .review-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .card { padding: 24px; transition: transform .25s ease, border-color .25s ease; }
  .card:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .service-mark { display: block; width: 46px; height: 6px; border-radius: 99px; background: var(--accent); margin-bottom: 26px; }
  .service-card p, .case-item p, .steps p, .review-card blockquote, .visit-copy p, .contact-copy p, details p {
    color: var(--muted);
    line-height: 1.62;
  }
  .service-card ul { padding-left: 18px; margin: 18px 0 0; color: var(--muted); line-height: 1.7; }
  .process { display: grid; grid-template-columns: .75fr 1.25fr; gap: 28px; align-items: start; background: color-mix(in srgb, var(--accent-2) 13%, transparent); }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .steps article { padding: 24px; }
  .steps span { display: inline-block; margin-bottom: 28px; color: var(--accent); font-weight: 900; }
  .case-list { display: grid; gap: 14px; }
  .case-item { padding: 24px; display: grid; grid-template-columns: .6fr 1fr .9fr; gap: 24px; align-items: center; }
  .case-item strong { color: var(--accent); line-height: 1.45; }
  .reviews { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .review-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .review-card { margin: 0; }
  .review-card blockquote { margin: 0 0 24px; font-size: 1.08rem; }
  .review-card figcaption { font-weight: 900; color: var(--accent); }
  .visit, .contact { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(22px, 5vw, 70px); align-items: center; }
  .visit-copy, .contact-copy { max-width: 560px; }
  .contact-strip { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 24px; }
  .contact-strip a, .contact-strip span, .phone-link {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 800;
    background: var(--panel);
  }
  .map-panel { min-height: 420px; overflow: hidden; }
  iframe { width: 100%; height: 100%; border: 0; display: block; }
  .contact-form { padding: clamp(20px, 4vw, 34px); display: grid; gap: 16px; }
  label { display: grid; gap: 8px; font-weight: 800; color: var(--ink); }
  input, select, textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, white 88%, var(--paper));
    min-height: 46px;
    padding: 12px 14px;
    font: inherit;
    color: var(--ink);
  }
  textarea { resize: vertical; }
  .contact-form button { width: fit-content; font: inherit; padding: 0 24px; }
  .faq-list { display: grid; gap: 12px; max-width: 920px; }
  details { padding: 20px 22px; }
  summary { cursor: pointer; font-weight: 900; }
  details p { margin-bottom: 0; }
  .theme-performance .hero { background: linear-gradient(90deg, rgba(35,31,28,.04), rgba(220,107,53,.13)); }
  .theme-performance .hero-media img { transform: rotate(-2deg); filter: contrast(1.06); }
  .theme-editorial .hero { grid-template-columns: .9fr .8fr; }
  .theme-editorial .hero-media img { border-radius: 0; transform: none; }
  .theme-natural .hero-media img { border-radius: 8px 8px 120px 8px; }
  .theme-medical .card, .theme-medical .case-item, .theme-medical .steps article, .theme-medical details, .theme-medical .contact-form, .theme-medical .map-panel { box-shadow: none; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes floatIn { from { opacity: 0; transform: translateY(24px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; scroll-behavior: auto !important; transition: none !important; }
  }
  @media (max-width: 1040px) {
    .hero, .visit, .contact, .process { grid-template-columns: 1fr; }
    .service-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-media { min-height: 0; justify-content: start; }
    .hero-media img { max-width: 330px; }
    .intro-band { margin-top: 0; }
  }
  @media (max-width: 760px) {
    .topbar { grid-template-columns: 1fr auto; }
    .navlinks { display: none; }
    .hero { min-height: auto; }
    .hero-stats, .service-grid, .steps, .review-grid { grid-template-columns: 1fr; }
    .case-item { grid-template-columns: 1fr; gap: 10px; }
    .intro-band { display: grid; }
    .intro-band a { white-space: normal; }
    h1 { font-size: clamp(2.8rem, 18vw, 4rem); }
    .map-panel { min-height: 320px; }
  }
</style>
