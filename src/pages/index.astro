---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand, concepts, socialLinks } from '../content';
---
<BaseLayout title="Body Reset Website Concepts">
  <main class="hub">
    <section class="hero">
      <div class="copy">
        <p class="eyebrow">Stakeholder demos</p>
        <h1>{brand.name} {brand.byline}</h1>
        <p>Twenty-three complete look-and-feel routes for the same injury and pain management website. Each version includes services, case studies, reviews, map, FAQs, contact form, and social links.</p>
        <div class="hub-social" aria-label="Dummy social media links">
          {socialLinks.map((social) => (
            <a href={social.href}>{social.label}</a>
          ))}
        </div>
      </div>
      <img src="/businesscard.jpeg" alt="Body Reset by Georgia business card" />
    </section>
    <section class="concepts" aria-label="Website concepts">
      {concepts.map((concept) => (
        <a class={`concept ${concept.className}`} href={`/concepts/${concept.slug}/`}>
          <span>{concept.mood}</span>
          <h2>{concept.name}</h2>
          <p>{concept.description}</p>
          <strong>Open demo</strong>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
<style is:global>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f6f2ea;
    color: #3f3a32;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; }
  .hub {
    min-height: 100vh;
    padding: clamp(20px, 4vw, 56px);
    background:
      radial-gradient(circle at 12% 18%, rgba(154, 171, 154, .32), transparent 28%),
      linear-gradient(135deg, #f8f4ed 0%, #e7e0d4 100%);
  }
  .hub .hero {
    min-height: min(72vh, 760px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 390px);
    gap: clamp(28px, 6vw, 80px);
    align-items: center;
    max-width: 1180px;
    margin: 0 auto;
  }
  .copy { max-width: 760px; }
  .eyebrow, .concept span {
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .78rem;
    font-weight: 800;
    color: #8b7655;
  }
  h1 {
    margin: 10px 0 18px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: .92;
    letter-spacing: 0;
  }
  .hub .hero p {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.65;
    max-width: 680px;
  }
  .hub-social {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  .hub-social a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(63, 58, 50, .13);
    border-radius: 999px;
    padding: 0 16px;
    background: rgba(255,255,255,.58);
    text-decoration: none;
    font-size: .9rem;
    font-weight: 800;
  }
  .hub img {
    width: 100%;
    aspect-ratio: 9 / 13;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 22px 70px rgba(54, 49, 42, .22);
  }
  .concepts {
    max-width: 1180px;
    margin: -10vh auto 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    position: relative;
    z-index: 2;
  }
  .concept {
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    padding: 22px;
    border: 1px solid rgba(63, 58, 50, .12);
    border-radius: 8px;
    background: rgba(255,255,255,.76);
    box-shadow: 0 18px 40px rgba(63, 58, 50, .09);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .concept:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 54px rgba(63, 58, 50, .16);
  }
  .concept h2 { margin: 18px 0 10px; font-size: clamp(1.25rem, 2vw, 1.7rem); }
  .concept p { margin: 0 0 20px; line-height: 1.55; }
  .concept strong { color: var(--accent, #8b7655); }
  .theme-calm { --accent: #9a845c; }
  .theme-performance { --accent: #dd6d35; }
  .theme-editorial { --accent: #776248; }
  .theme-natural { --accent: #6c7d58; }
  .theme-medical { --accent: #2c7c8c; }
  .theme-anatomy { --accent: #d45d48; }
  .theme-sports { --accent: #ef7746; }
  .theme-kinetic { --accent: #5569ff; }
  .theme-elite { --accent: #c98b4f; background: #1d1c1a; color: #f4efe6; }
  .theme-bodymap { --accent: #9a6fb1; }
  .theme-runner { --accent: #ff6b54; background: #e8f7f6; }
  .theme-bluegold { --accent: #d9a441; background: #061b39; color: #fff8e6; }
  .theme-skygold { --accent: #d6a23c; background: #eef8ff; }
  .theme-mint { --accent: #1fae9b; background: #effbf6; }
  .theme-sunrise { --accent: #df9272; background: #fff3eb; }
  .theme-anatomyphoto { --accent: #48d6ff; background: #081828; color: #f3fbff; }
  .theme-cleananatomy { --accent: #31b6c7; background: #f5fcff; }
  .theme-pureclinic { --accent: #347fbd; background: #ffffff; }
  .theme-aqualab { --accent: #22b8b2; background: #eefdfb; }
  .theme-softhealth { --accent: #7ab6d8; background: #fffafa; }
  .theme-clinicjourney { --accent: #29aeb8; background: #f6fdff; }
  .theme-distributedclinic { --accent: #38aeb7; background: #f7fdff; }
  .theme-georgiaclinic { --accent: #8b7655; background: #f8fcfb; }
  @media (max-width: 980px) {
    .hub .hero { grid-template-columns: 1fr; }
    .hub img { max-width: 360px; }
    .concepts { margin-top: 30px; grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .concepts { grid-template-columns: 1fr; }
  }
</style>
